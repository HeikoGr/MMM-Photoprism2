{
  "name": "MMM-Photoprism2 (MagicMirror Dev)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/opt/magic_mirror/modules/MMM-Photoprism2",
  "workspaceMount": "source=${localWorkspaceFolder},target=/opt/magic_mirror/modules/MMM-Photoprism2,type=bind",
  "overrideCommand": false,
  "runArgs": ["--shm-size=1g"],
  "shutdownAction": "stopContainer",
  "remoteUser": "root",
  "containerEnv": {
    "IN_DEVCONTAINER": "1",
    "PLAYWRIGHT_CHROMIUM_ARGS": "--no-sandbox --disable-dev-shm-usage --disable-gpu"
  },
  "forwardPorts": [
    8080
  ],
  // The host's Claude Code config is mounted read-only so the container can inherit
  // the login. Runtime bind mount: nothing lands in the image, and the path below is
  // all that is committed. Read-only on purpose - the container runs as root, so a
  // writable mount would leave root-owned files in the host's ~/.claude.
  // postStartCommand copies the credentials into the container's own ~/.claude.
  "mounts": ["source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/tmp/host-claude,type=bind,readonly"],

  "customizations": {
    "vscode": {
      // All shared extensions come from the base image (devcontainer.metadata label in
      // MMM-DevContainer/docker/Dockerfile) and are merged in automatically.
      "extensions": [],
      "settings": {
        "chat.mcp.autoStart": true,
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true
      }
    }
  },
  "postCreateCommand": "/bin/sh .devcontainer/postCreate.sh",
  "postStartCommand": "mkdir -p /tmp/playwright-mcp; mkdir -p /root/.claude; if [ -f /tmp/host-claude/.credentials.json ]; then cp /tmp/host-claude/.credentials.json /root/.claude/.credentials.json && chmod 600 /root/.claude/.credentials.json && echo 'Claude Code credentials inherited from host'; else echo 'No host Claude Code credentials found - run: claude login'; fi; echo 'Devcontainer started. MagicMirror at http://localhost:8080'; echo 'Playwright MCP: .mcp.json (Claude Code) and .vscode/mcp.json (Copilot Chat)'"
}
{
  "name": "mmm-photoprism2",
  "version": "1.0.7",
  "description": "MagicMirror² module to display random photos from PhotoPrism albums",
  "main": "MMM-Photoprism2.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeikoGr/MMM-Photoprism2.git"
  },
  "scripts": {
    "lint": "eslint --ext .js && prettier --check .",
    "lint:fix": "eslint --fix && prettier --write .",
    "test": "node --run lint",
    "test:spelling": "cspell .",
    "check": "node check.js ../../config/config.js || true",
    "mmcheck": "node scripts/magicmirror-check.mjs --current || true"
  },
  "keywords": [
    "MagicMirror²",
    "PhotoPrism",
    "photos",
    "images"
  ],
  "author": "HeikoGr",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cspell": "^9.7.0",
    "eslint": "^10.2.0",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-jinja-template": "2.1.0"
  }
}
{
  "name": "mmm-photoprism2",
  "version": "1.0.8",
  "description": "MagicMirror² module to display random photos from PhotoPrism albums",
  "main": "MMM-Photoprism2.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeikoGr/MMM-Photoprism2.git"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --run lint",
    "test:spelling": "cspell .",
    "check": "node check.js ../../config/config.js || true",
    "mmcheck": "node scripts/magicmirror-check.mjs --devcontainer-only --current || true",
    "deps:check": "npm outdated && ncu",
    "deps:update": "ncu -u && npm install"
  },
  "keywords": [
    "MagicMirror²",
    "PhotoPrism",
    "photos",
    "images"
  ],
  "author": "HeikoGr",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "cspell": "^10.0.0",
    "prettier-plugin-jinja-template": "2.1.0"
  }
}

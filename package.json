{
  "name": "mmm-photoprism2",
  "version": "1.0.16",
  "description": "MagicMirror² module to display random photos from PhotoPrism albums",
  "main": "MMM-Photoprism2.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeikoGr/MMM-Photoprism2.git"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "postinstall": "node scripts/install-mmm-shared-submodule.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test tests/*.test.js && node --run lint",
    "check": "node --run mmcheck",
    "mmcheck": "node scripts/magicmirror-check.mjs --devcontainer-only --current",
    "deps:update": "npx --yes npm-check-updates -u && npm install && npx @biomejs/biome migrate --write",
    "shared:update": "git submodule update --remote --init --checkout lib/mmm-shared && git submodule status lib/mmm-shared"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --files-ignore-unknown=true"
    ]
  },
  "keywords": [
    "MagicMirror²",
    "PhotoPrism",
    "photos",
    "images"
  ],
  "author": "HeikoGr",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "lint-staged": "^17.3.0",
    "prettier-plugin-jinja-template": "2.2.0",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged",
    "commit-msg": "npx --no-install commitlint --edit $1 && node scripts/check-commit-scope.js $1"
  },
  "allowScripts": {
    "simple-git-hooks@2.13.1": true
  }
}
{
  "name": "mmm-photoprism2",
  "version": "1.2.1",
  "private": true,
  "description": "MagicMirror² module to display random photos from PhotoPrism albums",
  "keywords": [
    "MagicMirror²",
    "PhotoPrism",
    "photos",
    "images"
  ],
  "homepage": "https://github.com/HeikoGr/MMM-Photoprism2#readme",
  "bugs": {
    "url": "https://github.com/HeikoGr/MMM-Photoprism2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeikoGr/MMM-Photoprism2.git"
  },
  "license": "MIT",
  "author": "HeikoGr",
  "type": "commonjs",
  "main": "MMM-Photoprism2.js",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "postinstall": "node scripts/install-mmm-shared-submodule.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/magicmirror-check.mjs --current",
    "shared:update": "git submodule update --remote --init --checkout lib/mmm-shared && git submodule status lib/mmm-shared",
    "deps:update": "npx --yes npm-check-updates -u && npm install && biome migrate --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "lint-staged": "^17.5.1",
    "simple-git-hooks": "^2.14.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --files-ignore-unknown=true"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged",
    "commit-msg": "node scripts/check-commit-msg.js $1 && node scripts/check-commit-scope.js $1"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true
  }
}
